# AIOps Engine Configuration Template
# Скопируйте этот файл в .env и укажите ваш API-ключ:
# cp .env.example .env

# 1. OpenAI (по умолчанию)
OPENAI_API_KEY=sk-your-openai-api-key-here
AIOPS_MODEL=gpt-4o-mini

# 2. Если используете OpenRouter, DeepSeek или локальный vLLM (раскомментируйте):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AIOPS_MODEL=deepseek/deepseek-chat

# OPENAI_BASE_URL=https://api.deepseek.com/v1
# AIOPS_MODEL=deepseek-chat
